{
  "name": "jonathan.fung.dev",
  "description": "My personal website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "dev": "npm run dev:client && npm run dev:server",
    "dev:client": "vite build --watch --outDir dist/client",
    "dev:server": "vite build --watch --ssr src/entry-server.tsx --outDir dist/server",
    "generate": "vite build --outDir dist/static && npm run build:server && node prerender",
    "serve": "cross-env NODE_ENV=production node server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanfung/jonathan.fung.dev.git"
  },
  "author": "Jonathan Fung",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jonathanfung/jonathan.fung.dev/issues"
  },
  "homepage": "https://github.com/jonathanfung/jonathan.fung.dev#readme",
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.4.1",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "compression": "^1.8.0",
    "cross-env": "^7.0.3",
    "express": "^5.1.0",
    "prettier": "^3.5.3",
    "serve-static": "^2.2.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.4"
  }
}
